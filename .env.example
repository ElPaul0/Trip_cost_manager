POSTGRES_USER=tripuser
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=trip_cost_manager
APP_PORT=8000

# Image utilisée par docker-compose.deploy.yml
# :latest = dernière version | :1.0 = version figée pour rollback
APP_IMAGE=ghcr.io/elpaul0/trip_cost_manager:latest

# Local (hors Docker) : SQLite par défaut si DATABASE_URL non défini
# DATABASE_URL=sqlite:///./trip_cost_manager.db
